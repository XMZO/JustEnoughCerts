{
  "components": {
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "description": "BCP 47 tag of the language chosen for the account",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Message key, rendered by the client in the viewer's language",
            "type": "string"
          },
          "fields": {
            "description": "The request fields at fault",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "params": {
            "additionalProperties": {},
            "description": "Arguments of the message",
            "type": "object"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Message key",
            "type": "string"
          },
          "location": {
            "description": "Where in the request, e.g. body.domains[1]",
            "type": "string"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "type": "object"
      },
      "ManifestBody": {
        "additionalProperties": false,
        "properties": {
          "modules": {
            "description": "Every module compiled in, by category and ID",
            "items": {
              "$ref": "#/components/schemas/ModuleInfo"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "version": {
            "description": "Program version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "modules"
        ],
        "type": "object"
      },
      "ModuleInfo": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "source",
              "solver",
              "target",
              "notifier",
              "feature"
            ],
            "type": "string"
          },
          "description": {
            "description": "Message key of the module description",
            "type": "string"
          },
          "enabled": {
            "description": "Running: switched on, and every module it requires too",
            "type": "boolean"
          },
          "experimental": {
            "description": "Off until switched on, and may break",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "Message key of the module name",
            "type": "string"
          },
          "required": {
            "description": "Always on",
            "type": "boolean"
          },
          "requires": {
            "description": "Modules this one needs",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "switched": {
            "description": "Switched on by itself",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "category",
          "name",
          "description",
          "switched",
          "enabled"
        ],
        "type": "object"
      },
      "SetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "description": "BCP 47 tag of the language the account starts with",
            "maxLength": 35,
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          },
          "token": {
            "description": "The one-time setup token from the server log",
            "maxLength": 128,
            "type": "string"
          },
          "username": {
            "description": "Letters, digits, dots, underscores and hyphens",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[\\p{L}\\p{N}._-]+$",
            "type": "string"
          }
        },
        "required": [
          "token",
          "username",
          "password"
        ],
        "type": "object"
      },
      "SetupStatusBody": {
        "additionalProperties": false,
        "properties": {
          "required": {
            "description": "No account exists yet: the setup wizard has to run",
            "type": "boolean"
          }
        },
        "required": [
          "required"
        ],
        "type": "object"
      },
      "SignInInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "jec_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Just Enough Certs",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/manifest": {
      "get": {
        "operationId": "get-manifest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManifestBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the modules and their state",
        "tags": [
          "kernel"
        ]
      }
    },
    "/session": {
      "delete": {
        "operationId": "sign-out",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      },
      "get": {
        "operationId": "get-session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the signed-in account",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "sign-in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/setup": {
      "get": {
        "operationId": "get-setup",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Tell whether the first account still has to be created",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Create the first account with the setup token, and sign in",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ],
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
