{
  "components": {
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "description": "BCP 47 tag of the language chosen for the account",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "type": "object"
      },
      "AddInputBody": {
        "additionalProperties": false,
        "properties": {
          "certificate": {
            "description": "PEM certificates: the leaf and its intermediates, in any order. The private key may come along.",
            "maxLength": 262144,
            "minLength": 1,
            "type": "string"
          },
          "privateKey": {
            "description": "The PEM private key, unless it is in certificate",
            "maxLength": 65536,
            "type": "string"
          },
          "renewBeforeDays": {
            "description": "Days before the end to send a reminder; 30 if left out",
            "format": "int64",
            "maximum": 365,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "certificate"
        ],
        "type": "object"
      },
      "CertificateBody": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "$ref": "#/components/schemas/VersionBody",
            "description": "The version in use"
          },
          "domains": {
            "description": "The domains, the primary first",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "keyType": {
            "description": "Type and size of the key, such as rsa-2048 or ecdsa-p256",
            "type": "string"
          },
          "renewBeforeDays": {
            "description": "How many days before the end the certificate is renewed, or a reminder sent",
            "format": "int64",
            "type": "integer"
          },
          "source": {
            "description": "Where new versions come from",
            "enum": [
              "upload"
            ],
            "type": "string"
          },
          "state": {
            "description": "ok; expiring: within RenewBeforeDays of the end; expired",
            "enum": [
              "ok",
              "expiring",
              "expired"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "domains",
          "source",
          "keyType",
          "renewBeforeDays",
          "state",
          "createdAt"
        ],
        "type": "object"
      },
      "ChainEntry": {
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "type": "string"
          },
          "notAfter": {
            "format": "date-time",
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "issuer",
          "notAfter"
        ],
        "type": "object"
      },
      "DetailOutputBody": {
        "additionalProperties": false,
        "properties": {
          "certificate": {
            "$ref": "#/components/schemas/CertificateBody"
          },
          "chain": {
            "description": "The chain of the current version, the leaf first",
            "items": {
              "$ref": "#/components/schemas/ChainEntry"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "versions": {
            "description": "Every version, the newest first",
            "items": {
              "$ref": "#/components/schemas/VersionBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "certificate",
          "versions",
          "chain"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Message key, rendered by the client in the viewer's language",
            "type": "string"
          },
          "fields": {
            "description": "The request fields at fault",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "params": {
            "additionalProperties": {},
            "description": "Arguments of the message",
            "type": "object"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Message key",
            "type": "string"
          },
          "location": {
            "description": "Where in the request, e.g. body.domains[1]",
            "type": "string"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "certificates": {
            "description": "The soonest to expire first",
            "items": {
              "$ref": "#/components/schemas/CertificateBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "certificates"
        ],
        "type": "object"
      },
      "ManifestBody": {
        "additionalProperties": false,
        "properties": {
          "modules": {
            "description": "Every module compiled in, by category and ID",
            "items": {
              "$ref": "#/components/schemas/ModuleInfo"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "version": {
            "description": "Program version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "modules"
        ],
        "type": "object"
      },
      "ModuleInfo": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "source",
              "solver",
              "target",
              "notifier",
              "feature"
            ],
            "type": "string"
          },
          "description": {
            "description": "Message key of the module description",
            "type": "string"
          },
          "enabled": {
            "description": "Running: switched on, and every module it requires too",
            "type": "boolean"
          },
          "experimental": {
            "description": "Off until switched on, and may break",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "Message key of the module name",
            "type": "string"
          },
          "required": {
            "description": "Always on",
            "type": "boolean"
          },
          "requires": {
            "description": "Modules this one needs",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "switched": {
            "description": "Switched on by itself",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "category",
          "name",
          "description",
          "switched",
          "enabled"
        ],
        "type": "object"
      },
      "PEMFields": {
        "additionalProperties": false,
        "properties": {
          "certificate": {
            "description": "PEM certificates: the leaf and its intermediates, in any order. The private key may come along.",
            "maxLength": 262144,
            "minLength": 1,
            "type": "string"
          },
          "privateKey": {
            "description": "The PEM private key, unless it is in certificate",
            "maxLength": 65536,
            "type": "string"
          }
        },
        "required": [
          "certificate"
        ],
        "type": "object"
      },
      "SetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "description": "BCP 47 tag of the language the account starts with",
            "maxLength": 35,
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          },
          "token": {
            "description": "The one-time setup token from the server log",
            "maxLength": 128,
            "type": "string"
          },
          "username": {
            "description": "Letters, digits, dots, underscores and hyphens",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[\\p{L}\\p{N}._-]+$",
            "type": "string"
          }
        },
        "required": [
          "token",
          "username",
          "password"
        ],
        "type": "object"
      },
      "SetupStatusBody": {
        "additionalProperties": false,
        "properties": {
          "required": {
            "description": "No account exists yet: the setup wizard has to run",
            "type": "boolean"
          }
        },
        "required": [
          "required"
        ],
        "type": "object"
      },
      "SignInInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "UpdateInputBody": {
        "additionalProperties": false,
        "properties": {
          "renewBeforeDays": {
            "format": "int64",
            "maximum": 365,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "renewBeforeDays"
        ],
        "type": "object"
      },
      "VersionBody": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "fingerprint": {
            "description": "SHA-256 of the certificate, lowercase hex",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "issuer": {
            "type": "string"
          },
          "keyType": {
            "type": "string"
          },
          "names": {
            "description": "The names the certificate is valid for",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "notAfter": {
            "format": "date-time",
            "type": "string"
          },
          "notBefore": {
            "format": "date-time",
            "type": "string"
          },
          "origin": {
            "description": "How the version came",
            "enum": [
              "upload"
            ],
            "type": "string"
          },
          "serial": {
            "description": "Serial number, lowercase hex",
            "type": "string"
          }
        },
        "required": [
          "id",
          "origin",
          "names",
          "serial",
          "fingerprint",
          "issuer",
          "keyType",
          "notBefore",
          "notAfter",
          "createdAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "jec_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Just Enough Certs",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/certs/certificates": {
      "get": {
        "operationId": "certs-list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the certificates",
        "tags": [
          "certs"
        ]
      },
      "post": {
        "operationId": "certs-add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Add a certificate by uploading it with its private key",
        "tags": [
          "certs"
        ]
      }
    },
    "/certs/certificates/{id}": {
      "delete": {
        "operationId": "certs-delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete a certificate with all its versions",
        "tags": [
          "certs"
        ]
      },
      "get": {
        "operationId": "certs-get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get a certificate with its versions and chain",
        "tags": [
          "certs"
        ]
      },
      "patch": {
        "operationId": "certs-update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change the renewal policy of a certificate",
        "tags": [
          "certs"
        ]
      }
    },
    "/certs/certificates/{id}/versions": {
      "post": {
        "operationId": "certs-upload",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PEMFields"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Upload a new version of a certificate",
        "tags": [
          "certs"
        ]
      }
    },
    "/manifest": {
      "get": {
        "operationId": "get-manifest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManifestBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the modules and their state",
        "tags": [
          "kernel"
        ]
      }
    },
    "/session": {
      "delete": {
        "operationId": "sign-out",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      },
      "get": {
        "operationId": "get-session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the signed-in account",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "sign-in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/setup": {
      "get": {
        "operationId": "get-setup",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Tell whether the first account still has to be created",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Create the first account with the setup token, and sign in",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ],
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
