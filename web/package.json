{
  "name": "jec-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.mjs",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "node scripts/size.mjs",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.71.0",
    "@tanstack/vue-query": "5.107.1",
    "intl-messageformat": "12.1.5",
    "openapi-fetch": "0.17.0",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "jsonc-eslint-parser": "3.3.0",
    "openapi-typescript": "7.13.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "yaml-eslint-parser": "2.1.0"
  }
}
